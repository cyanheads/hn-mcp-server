{
  "name": "@cyanheads/hn-mcp-server",
  "version": "0.5.12",
  "description": "Browse Hacker News feeds, threads, and user profiles with full-text search via MCP. STDIO or Streamable HTTP.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hn-mcp-server": "dist/index.js"
  },
  "files": ["dist/", "README.md", "LICENSE", "CLAUDE.md", "Dockerfile", "server.json"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "rebuild": "bun scripts/clean.ts && bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "devcheck": "bun scripts/devcheck.ts",
    "tree": "bun scripts/tree.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "list-skills": "bun scripts/list-skills.ts",
    "lint:mcp": "bun scripts/lint-mcp.ts",
    "lint:packaging": "bun scripts/lint-packaging.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/hn-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/hn-mcp-server.mcpb",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "changelog:build": "bun scripts/build-changelog.ts",
    "changelog:check": "bun scripts/build-changelog.ts --check",
    "release:github": "bun scripts/release-github.ts",
    "test": "bun --bun vitest run",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish"
  },
  "mcpName": "io.github.cyanheads/hn-mcp-server",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "typescript",
    "bun",
    "stdio",
    "streamable-http",
    "hacker-news",
    "hn",
    "firebase",
    "algolia"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/hn-mcp-server.git"
  },
  "homepage": "https://github.com/cyanheads/hn-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/hn-mcp-server/issues"
  },
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "license": "Apache-2.0",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@hono/otel": "^1.1.2",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/node": "^26.1.1",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.6",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

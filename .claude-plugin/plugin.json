{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "hn-mcp-server",
  "version": "0.5.16",
  "description": "Browse Hacker News feeds, threads, and user profiles with full-text search via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/hn-mcp-server#readme",
  "repository": "https://github.com/cyanheads/hn-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "hacker-news", "hn", "firebase", "algolia"],
  "mcpServers": {
    "hn-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/hn-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
